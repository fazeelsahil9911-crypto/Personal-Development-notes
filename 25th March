YAML

stages:
  - build
  - test
  - deploy

variables:
  IMAGE_NAME: 
  IMAGE_TAG:

build-job:
  stage: build
  image: docker.latest
  services:
    - docker:dind
  script:
    - docker build -t $IMAGE_NAME:$IMAGE_TAG .
    - docker save $IMAGE_NAME:$IMAGE_TAG > nginx.tar
  artifacts:
    paths: 
      - nginx.tar

test-job:
  stage: test
  image: docker:latest
  services:
    - docker:dind
  script:
    - docker load < nginx.tar
    - docker run -d -p 8080:80 --name nginx-test $IMAGE_NAME:$IMAGE
    - sleep 5
    - curl -f http://localhost:8080 || exit 1
  dependencies:
    - build-job

deploy-job:
  stage: deploy
  script:
    - echo "Deploying NGINX container..."
    - ./scripts/deploy_nginx.sh
  only:
    - main

