## Persistent Volune + PVC
YAML
apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  hostpath:
    path: /data

YAML
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc
  namespace: dev
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi

## RBAC + ServiceAccount + PDB
# ServiceAccount
YAML
metadata:
  name: app-sa 
  namespace: dev

# Role + Binding
YAML
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: dev
  name: app-role
rules:
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["get", "list"]

## Pod Disruption Budget
YAML
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: pdb
  namespace: dev
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: node

