## Ingress
YAML
metadata:
  name: app-ingress
  namespace: dev
spec:
  rules:
  - host: myapp.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: node-service
            port:
              number: 80

