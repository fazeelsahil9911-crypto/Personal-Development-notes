## GitLab CI/CD Pipeline (gitlab-ci.yml)
YAML
stages:
  - build
  - push 
  - deploy

variables:
  IMAGE_NAME:

before_script:
  - echo :Logging into GitLab container Registry"
  - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $CI

build:
  stage: build
  script:
    - docker build -t $IMAGE_NAME:$CI_COMMIT_SHORT_SHA
  only:
    - main

push:
  stage: push 
  script:
    - docker push $IMAGE_NAME:$CI_COMMIT_SHORT_SHA
  only:
    - main

deploy:
  stage: deploy
  script:
    - kubectl set image deployment/nginx-deployment nginx=$IMAGE_NAME:$CI_COMMIT_SHORT_SHA -n dev
  only:
    - main

## Jenkinsfile (Groovy Pipeline)
## groovy
pipeline {
   agent any

   environment {
       IMAGE_NAME - "my-app"
       TAAG = "${env.BUILD_NUMBER}"
   }

   stages {
      stage('Checkout') {
          steps {
              git 'https://github.com/your-repo.git'
          }
      }

      stage('Build Docker Image') {
          steps {
              sh "docker build -t $IMAGE_NAME:$TAG ."
          }
      }

      stage('Push Image') {
          steps {
              sh "docker tag $IMAGE_NAME:$TAG 
              sh "docker push your-dockerhub/$IMAGE_NAME:$TAG"
          }
      }

      stage('Deploy to Kubernetes') {
          steps {
              sh "kubectl set image deployment/nginx-deployment nginx=your-dockerhub/$IMAGE_NAME:$TAG -n dev"
          }
       }
   }
}

