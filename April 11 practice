## Deployment with ConfigMap + Secret
YAML
apiVersion: apps/v1
kind: Deployment 
metadata:
  name: app-with-config
  namespace: dev
spec:
  replicas: 2
  selector:
    matchLabels:
      app: config-demo
  template:
     metadata:
       labels:
         app: config-demo
     spec:
       containers:
       - name: app
         image:
         env:
         - name: APP_ENV
           valueFrom:
             configMapKeyRef:
               name: app-config
               key: APP_ENV
         - name: DB_PASSWORD
           valueFrom:
             secretKeyRef:
               name: app-secret

