##CI/CD Pipeline Examples

# GitLab 
YAML
stages:
  - build
  - test
  - deploy

build-job: 
  stage: build
  script:
    - echo "Building project..."
    - mvn clean package

test-job:
  stage: test
  script:
    - echo "Running package..."
    - mvn test

deploy-job:
  stage: deploy
  script:
    - echo: "Deploying app..."
    - kubectl apply -f k8s/

## Jenkins Groovy Pipeline (Jenkinsfile)

pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        } 
        stage('Test') {
            steps {
                sh 'mvn test
            }
        }
        stage('Deploy') {
            steps {
                sh 'kuberctl apply -f k8s/'
            }
        } 
    }
}

