## Namespace
YAML

apiVersion: v1
kind: Namespace
metadata:
  name: dev

## Resource Quota

YAML

apiVersion: v1
kind: ResourceQuota
metadata:
  name: dev-quota
  namespace: dev
spec:
  hard:
    pods: "5"
    requests.cpu" "2"
    requests.memory: 2Gi 
    limits.cpu: "4"
    limits.memory: 4Gi

## Limit Range 

YAML

apiVersion: v1
kind: LimitRange 
metadata:
  name: dev-limits
  namespace: dev
spec:
  limits:
  - default:
      cpu: "500m"
      memory: "512Mi"
    defaultRequest:
      cpu: "200m"
      memory: "265Mi"
    type: Container

