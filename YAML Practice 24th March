## Terraform (Most Common Patterns)
# Variables.tf
hcl
variable "region" {
  defualt = "ap-south-1"
}

variable "instance_type" {
  default = "t2.micro"
}

## main.tf (EC2 Example)
hcl

provider "aws" {
  region = var.region
}

resource "aws_instance" "app" {
  ami           = data.aws_ami.latest.id
  instance_type = var.instance_type

  tags = {
    Name = "dev-server"
  }
}

## Data source 

hcl
data "aws_ami" "latest" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["amzn2-ami-hvm-*"]
  }
}

## Output/tf
hcl
output "public_ip" {
  value = aws_instance.app.public_ip
}

Module usage 

## Module/main.tf
hcl
resource "aws_instance" "this" {
  ami           = var.ami
  instance_type = var.instance_type
}

root main.tf
hcl
module "ec2" {
  source        = "./modules/ec2"
  ami           = "ami-123"
  instance_type = "t2.micro"
}

## CI/CD Pipelines (Most Used)

GitLab CI/CD (Real-World)

Stages:
  - build
  - test
  - deploy

variables: 
  IMAGE: myapp

build:
  stage: build
  script:
    - docker build -t $IMAGE .
    - docker tag $IMAGE registry/myapp
    - docker push registry/myapp

deploy:
  stage: deploy
  script:
    - kubectl apply -f k8s/

## Jenkins Pipeline (Groovy)

groovy

pipeline {
  agent any

  environment {
    IMAGE = "myapp"
  }

  stages {
    stage('Build') {
      steps {
        sh 'docker build -t $IMAGE .'
    }
  }

  stage('Deploy') {
    steps {
      sh 'kubectl apply -f k8s/'
    }
  }
}
}



